# WebUntis-Server der Schule (nur fuer den Vite-Dev-Proxy)
VITE_WEBUNTIS_SERVER=https://<eure-schule>.webuntis.com
# Schulname wie im ?school=-Parameter
VITE_WEBUNTIS_SCHOOL=<schulname-wie-im-webuntis-login>
# Basis-URL des Produktions-Proxys (World4you). Leer lassen -> Dev-Proxy /WebUntis
VITE_WEBUNTIS_PROXY_BASE=
